/* XHCurl - Windows build configuration */

ARG_ENABLE("xhcurl", "enable xhcurl support", "no");

if (PHP_XHCURL != "no") {
    EXTENSION("xhcurl",
        "xhcurl.c " +
        "xhcurl_buffer.c " +
        "xhcurl_header.c " +
        "xhcurl_cookie.c " +
        "xhcurl_context.c " +
        "xhcurl_utils.c " +
        "xhcurl_response.c " +
        "xhcurl_request.c " +
        "xhcurl_multi.c " +
        "xhcurl_threadpool.c",
        PHP_XHCURL_SHARED);

    AC_DEFINE('HAVE_XHCURL', 1, 'Have xhcurl extension');
    AC_DEFINE('HAVE_WIN32_THREAD', 1, 'Have Windows thread support');
}
