// +----------------------------------------------------------------------+
// | XHCurl 扩展 - Windows 构建配置                                       |
// | 类似 curl 的 PHP 扩展，支持单次/批量/多线程同步异步请求               |
// +----------------------------------------------------------------------+

// 检查用户是否启用 xhcurl 扩展
// ARG_ENABLE 创建布尔/共享标志选项（no/yes/shared）
ARG_ENABLE("xhcurl", "enable xhcurl support", "no");

// 声明 libcurl 依赖路径选项
// ARG_WITH 创建路径选项（no/yes/路径字符串）
// 使用 "xhcurl-curl" 避免与 PHP 内置 curl 扩展的 "curl" 选项冲突
// --with-xhcurl-curl=C:\path\to\curl 会让 PHP_XHCURL_CURL = "C:\path\to\curl"
// CHECK_LIB 的第三个参数使用此路径来搜索库文件
ARG_WITH("xhcurl-curl", "path to libcurl for xhcurl support", "no");

if (PHP_XHCURL != "no") {
    // 检查 libcurl 库文件和头文件是否存在
    // CHECK_LIB("libcurl.lib", "xhcurl", PHP_XHCURL_CURL) 含义：
    //   第1参数：要查找的库文件名
    //   第2参数：扩展名（用于构建搜索路径 ext/xhcurl/lib）
    //   第3参数：额外的搜索路径提示（来自 --with-xhcurl-curl=PATH）
    // CHECK_HEADER_ADD_INCLUDE 在 include 路径中查找 curl/curl.h
    if (PHP_XHCURL_CURL != "no" &&
        CHECK_LIB("libcurl.lib", "xhcurl", PHP_XHCURL_CURL) &&
        CHECK_HEADER_ADD_INCLUDE("curl/curl.h", "CFLAGS_XHCURL", PHP_XHCURL_CURL + "\\include")) {

        // 声明扩展的源文件列表
        // 模块划分（遵循单一职责原则）：
        //   xhcurl.c           - 模块入口 + XHCurl 全局管理器类
        //   xhcurl_buffer.c    - 响应缓冲区管理（init/write/read/free）
        //   xhcurl_header.c    - HTTP 头部链表操作（add/find/free/parse）
        //   xhcurl_cookie.c    - Cookie 链表操作（add/free）
        //   xhcurl_context.c   - 请求执行上下文 + curl 回调函数
        //   xhcurl_utils.c     - 辅助工具函数（SAPI 判断、字符串处理）
        //   xhcurl_response.c  - XHResponse 懒加载响应类
        //   xhcurl_request.c   - XHRequest 请求构建器类
        //   xhcurl_multi.c     - XHMulti 批量异步执行器类
        //   xhcurl_threadpool.c - XHThreadPool CLI 线程池类
        EXTENSION("xhcurl",
            "xhcurl.c " +
            "xhcurl_buffer.c " +
            "xhcurl_header.c " +
            "xhcurl_cookie.c " +
            "xhcurl_context.c " +
            "xhcurl_utils.c " +
            "xhcurl_response.c " +
            "xhcurl_request.c " +
            "xhcurl_multi.c " +
            "xhcurl_threadpool.c",
            PHP_XHCURL_SHARED);

        // 定义扩展可用宏
        AC_DEFINE('HAVE_XHCURL', 1, 'Have xhcurl extension');

        // Windows 线程支持（线程池功能依赖）
        AC_DEFINE('HAVE_WIN32_THREAD', 1, 'Have Windows thread support');
    } else {
        WARNING("xhcurl not enabled; libcurl libraries and headers not found");
        WARNING("Please specify the path to libcurl using --with-curl=PATH");
    }
}
